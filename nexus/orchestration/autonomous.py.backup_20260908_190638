from __future__ import annotations

import json

from openai import OpenAI

from nexus.agent import Agent
from nexus.config import effective_config
from nexus.execution import (
    ParallelDAGExecutor,
)
from nexus.models import ModelRouter
from nexus.planning import (
    PLANNER_SYSTEM,
    parse_plan,
)


class AutonomousOrchestrator:
    def __init__(
        self,
        workspace,
        live=True,
    ):
        self.workspace = workspace

        self.config = effective_config(
            workspace
        )

        self.live = live

        self.client = OpenAI(
            base_url=self.config[
                "base_url"
            ],
            api_key="ollama",
        )

        self.router = ModelRouter(
            self.config
        )

    def plan(self, objective):
        response = (
            self.client
            .chat
            .completions
            .create(
                model=self.router.for_role(
                    "director"
                ),
                messages=[
                    {
                        "role": "system",
                        "content": (
                            PLANNER_SYSTEM
                        ),
                    },
                    {
                        "role": "user",
                        "content": objective,
                    },
                ],
                temperature=0.05,
                max_tokens=4096,
            )
        )

        text = (
            response
            .choices[0]
            .message
            .content
            or ""
        )

        return parse_plan(
            text
        )

    def execute_plan(self, plan):
        def runner(task):
            agent = Agent(
                self.config,
                self.workspace,
                role=task.role,
                live=self.live,
            )

            acceptance = ""

            if task.acceptance:
                acceptance = (
                    "\n\nACCEPTANCE CRITERIA:\n"
                    + "\n".join(
                        f"- {x}"
                        for x in task.acceptance
                    )
                )

            result = agent.run(
                task.objective
                + acceptance
            )

            # Do not infer PASS from prose containing
            # arbitrary occurrences of the word PASS.
            # A hard Nexus acceptance override is always failure.
            if (
                "NEXUS_ACCEPTANCE_OVERRIDE=FAIL"
                in result
                or "AGENT_EXCEPTION="
                in result
                or "MAX_ITERATIONS_REACHED"
                in result
            ):
                status = "FAIL"
            else:
                status = "PASS"

            return {
                "status": status,
                "result": result,
            }

        executor = ParallelDAGExecutor(
            plan.tasks,
            runner,
            max_parallel=self.config[
                "agents"
            ][
                "max_parallel"
            ],
        )

        return executor.execute()

    def run(self, objective):
        plan = self.plan(
            objective
        )

        results = self.execute_plan(
            plan
        )

        passed = all(
            r.status == "PASS"
            for r in results.values()
        )

        return {
            "objective": objective,
            "plan": {
                "tasks": [
                    {
                        "id": t.id,
                        "role": t.role,
                        "objective": (
                            t.objective
                        ),
                        "dependencies": (
                            t.dependencies
                        ),
                        "acceptance": (
                            t.acceptance
                        ),
                    }
                    for t in plan.tasks
                ]
            },
            "results": {
                tid: {
                    "role": r.role,
                    "status": r.status,
                    "result": r.result,
                    "started": r.started,
                    "finished": r.finished,
                }
                for tid, r
                in results.items()
            },
            "status": (
                "PASS"
                if passed
                else "FAIL"
            ),
        }
