from __future__ import annotations

import json
import re
from dataclasses import dataclass

from nexus.runtime.vision import (
    OllamaVisionProvider,
)


@dataclass
class GroundedTarget:
    x: float
    y: float
    confidence: float
    label: str
    raw: str


def _json_object(
    text,
):
    text = str(
        text or ""
    ).strip()

    try:
        value = json.loads(
            text
        )

        if isinstance(
            value,
            dict,
        ):
            return value

    except Exception:
        pass

    fenced = re.search(
        r"```(?:json)?\s*(\{.*?\})\s*```",
        text,
        re.S | re.I,
    )

    if fenced:
        return json.loads(
            fenced.group(1)
        )

    loose = re.search(
        r"\{.*\}",
        text,
        re.S,
    )

    if loose:
        return json.loads(
            loose.group(0)
        )

    raise ValueError(
        "VISION_GROUNDING_JSON_MISSING"
    )


def ground_target(
    image_path,
    model,
    target,
    width,
    height,
):
    provider = OllamaVisionProvider(
        model
    )

    prompt = f"""
You are performing visual UI grounding.

Screenshot dimensions:
width={int(width)}
height={int(height)}

Find this visible target:
{target}

Return JSON only:
{{
  "x": <pixel center x>,
  "y": <pixel center y>,
  "confidence": <0 to 1>,
  "label": "<short visible label>"
}}

Rules:
- Coordinates are screenshot pixel coordinates.
- Use the CENTER of the visible target.
- Do not describe anything else.
- Do not invent a target that is not visible.
"""

    finding = provider.analyze(
        image_path,
        prompt,
        num_predict=256,
    )

    data = _json_object(
        finding.summary
    )

    x = float(
        data["x"]
    )

    y = float(
        data["y"]
    )

    confidence = float(
        data.get(
            "confidence",
            0,
        )
    )

    label = str(
        data.get(
            "label",
            "",
        )
    )

    if not (
        0 <= x <= float(width)
        and 0 <= y <= float(height)
    ):
        raise ValueError(
            "VISION_GROUNDING_OUT_OF_BOUNDS"
        )

    if confidence < 0.40:
        raise ValueError(
            "VISION_GROUNDING_LOW_CONFIDENCE="
            + str(confidence)
        )

    return GroundedTarget(
        x=x,
        y=y,
        confidence=confidence,
        label=label,
        raw=finding.summary,
    )


def verify_visual_state(
    image_path,
    model,
):
    provider = OllamaVisionProvider(
        model
    )

    prompt = """
Inspect this UI screenshot.

Return JSON only:

{
  "armed": true or false,
  "typed_text": "<visible text in the input>",
  "success_visible": true or false
}

Interpret:
- armed=true only if the UI visibly says ARMED=YES.
- typed_text must be the visible text inside the input.
- success_visible=true only if the green success/status area
  visibly indicates SUCCESS.

Do not infer hidden DOM state.
Use visible pixels only.
"""

    finding = provider.analyze(
        image_path,
        prompt,
        num_predict=256,
    )

    data = _json_object(
        finding.summary
    )

    return data, finding.summary
