from __future__ import annotations

import base64
import json
import mimetypes
import time
import urllib.request
from dataclasses import dataclass, asdict
from pathlib import Path


@dataclass
class ScreenshotEvidence:
    path: str
    timestamp: float
    width: int | None = None
    height: int | None = None
    source: str = "computer"


@dataclass
class VisionFinding:
    summary: str
    confidence: float
    raw: str
    provider: str
    model: str
    screenshot: str


def _post_json(
    url: str,
    payload: dict,
    timeout: int = 600,
):
    body = json.dumps(
        payload
    ).encode(
        "utf-8"
    )

    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Content-Type": "application/json"
        },
        method="POST",
    )

    with urllib.request.urlopen(
        req,
        timeout=timeout,
    ) as response:
        return json.loads(
            response.read().decode(
                "utf-8"
            )
        )


def image_to_base64(
    path: str,
) -> str:
    p = Path(
        path
    ).expanduser().resolve()

    if not p.exists():
        raise FileNotFoundError(
            str(p)
        )

    return base64.b64encode(
        p.read_bytes()
    ).decode(
        "ascii"
    )


class OllamaVisionProvider:
    def __init__(
        self,
        model: str,
        base_url: str = (
            "http://127.0.0.1:11434"
        ),
    ):
        self.model = model
        self.base_url = (
            base_url.rstrip("/")
        )

    def analyze(
        self,
        image_path: str,
        prompt: str,
        *,
        num_predict: int = 512,
    ) -> VisionFinding:
        encoded = image_to_base64(
            image_path
        )

        payload = {
            "model": self.model,
            "messages": [
                {
                    "role": "user",
                    "content": prompt,
                    "images": [
                        encoded
                    ],
                }
            ],
            "stream": False,
            "keep_alive": "30m",
            "options": {
                "temperature": 0,
                "num_predict": int(
                    num_predict
                ),
            },
        }

        data = _post_json(
            self.base_url
            + "/api/chat",
            payload,
        )

        message = data.get(
            "message",
            {}
        )

        text = str(
            message.get(
                "content",
                ""
            )
        ).strip()

        if not text:
            raise RuntimeError(
                "VISION_EMPTY_RESPONSE"
            )

        return VisionFinding(
            summary=text,
            confidence=1.0,
            raw=text,
            provider="ollama",
            model=self.model,
            screenshot=str(
                Path(
                    image_path
                ).resolve()
            ),
        )


def finding_json(
    finding: VisionFinding,
):
    return json.dumps(
        asdict(
            finding
        ),
        ensure_ascii=False,
        indent=2,
    )
