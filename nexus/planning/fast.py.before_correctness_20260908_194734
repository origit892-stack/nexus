def simple_web_research_plan(
    objective,
):
    text = str(
        objective
    )

    low = text.lower()

    web = any(
        token in low
        for token in (
            "website",
            "web ",
            "homepage",
            "http",
            "online",
            "internet",
        )
    )

    verify = any(
        token in low
        for token in (
            "verify",
            "verification",
            "independent qa",
            "independently",
        )
    )

    write = any(
        token in low
        for token in (
            "implement",
            "modify",
            "write code",
            "fix code",
            "edit file",
        )
    )

    if not web or write:
        return None

    if verify:
        return {
            "objective": text,
            "tasks": [
                {
                    "id": "T1",
                    "role": "researcher",
                    "objective": (
                        "Gather the requested information "
                        "from the authoritative website "
                        "using direct web evidence."
                    ),
                    "dependencies": [],
                    "acceptance": [
                        "Requested fact obtained from authoritative web evidence"
                    ],
                },
                {
                    "id": "T2",
                    "role": "qa",
                    "objective": (
                        "Independently verify T1's finding "
                        "against the authoritative website "
                        "using your own source evidence."
                    ),
                    "dependencies": [
                        "T1"
                    ],
                    "acceptance": [
                        "Independent source evidence obtained",
                        "T1 finding confirmed or rejected",
                    ],
                },
            ],
        }

    return {
        "objective": text,
        "tasks": [
            {
                "id": "T1",
                "role": "researcher",
                "objective": (
                    "Gather the requested information "
                    "from the authoritative website "
                    "using direct web evidence."
                ),
                "dependencies": [],
                "acceptance": [
                    "Requested fact obtained from authoritative web evidence"
                ],
            }
        ],
    }


def compact_objective(
    objective,
    limit=1800,
):
    text = re.sub(
        r"\s+",
        " ",
        str(objective),
    ).strip()

    return text[:limit]
