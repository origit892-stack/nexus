from __future__ import annotations

import json
from dataclasses import dataclass, field


VALID_ROLES = {
    "architect",
    "coder",
    "qa",
    "researcher",
    "browser",
    "computer",
    "devops",
    "security",
}


@dataclass
class PlannedTask:
    id: str
    role: str
    objective: str
    dependencies: list[str] = field(default_factory=list)
    acceptance: list[str] = field(default_factory=list)


@dataclass
class Plan:
    objective: str
    tasks: list[PlannedTask]


PLANNER_SYSTEM = """
You are the Nexus execution planner.

Convert the user's objective into a small dependency DAG.

Rules:
- Use specialists rather than assigning everything to one agent.
- Independent read-only investigations should run in parallel.
- There may be only one Coder for overlapping implementation scope.
- QA must be independent from Coder.
- Browser tasks use browser/researcher.
- GUI interaction uses computer.
- CLI/server/SSH operations use devops.
- Every implementation task must have concrete acceptance criteria.
- A stub/mock/placeholder cannot satisfy real implementation acceptance.
- Do not claim execution occurred. You are planning only.

Return JSON only:

{
  "objective": "...",
  "tasks": [
    {
      "id": "T1",
      "role": "architect",
      "objective": "...",
      "dependencies": [],
      "acceptance": ["..."]
    }
  ]
}
"""


def validate_plan(raw):
    if not isinstance(raw, dict):
        raise ValueError("PLAN_NOT_OBJECT")

    tasks = raw.get("tasks")

    if not isinstance(tasks, list) or not tasks:
        raise ValueError("PLAN_HAS_NO_TASKS")

    ids = set()
    coder_count = 0

    result = []

    for item in tasks:
        tid = str(item["id"])
        role = str(item["role"])

        if tid in ids:
            raise ValueError(
                f"DUPLICATE_TASK_ID={tid}"
            )

        ids.add(tid)

        if role not in VALID_ROLES:
            raise ValueError(
                f"INVALID_ROLE={role}"
            )

        if role == "coder":
            coder_count += 1

        result.append(
            PlannedTask(
                id=tid,
                role=role,
                objective=str(
                    item["objective"]
                ),
                dependencies=list(
                    item.get(
                        "dependencies",
                        [],
                    )
                ),
                acceptance=list(
                    item.get(
                        "acceptance",
                        [],
                    )
                ),
            )
        )

    if coder_count > 1:
        raise ValueError(
            "MULTIPLE_CODERS_BLOCKED"
        )

    for task in result:
        for dep in task.dependencies:
            if dep not in ids:
                raise ValueError(
                    f"UNKNOWN_DEPENDENCY={dep}"
                )

            if dep == task.id:
                raise ValueError(
                    f"SELF_DEPENDENCY={task.id}"
                )

    return Plan(
        objective=str(
            raw.get(
                "objective",
                "",
            )
        ),
        tasks=result,
    )


def parse_plan(text):
    text = text.strip()

    if text.startswith("```"):
        lines = text.splitlines()
        lines = lines[1:]

        if lines and lines[-1].strip() == "```":
            lines = lines[:-1]

        text = "\n".join(lines)

    return validate_plan(
        json.loads(text)
    )
