from __future__ import annotations

import time
from pathlib import Path

from .store import JobStore
from .runner import JobRunner


class Scheduler:
    def __init__(
        self,
        workspace,
        poll_seconds=1.0,
    ):
        self.workspace = Path(
            workspace
        ).resolve()

        self.poll_seconds = float(
            poll_seconds
        )

    def run_once(self):
        store = JobStore(
            self.workspace
        )

        jobs = store.list_jobs(
            limit=100
        )

        for row in reversed(jobs):
            jid = row[0]
            status = row[3]

            if status in {
                "PENDING",
                "RUNNING",
            }:
                runner = JobRunner(
                    self.workspace
                )

                runner.run_job(
                    jid
                )

                return jid

        return None

    def run_forever(self):
        while True:
            self.run_once()

            time.sleep(
                self.poll_seconds
            )
